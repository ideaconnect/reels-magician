<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ReelsMagician.App.App"
             Name="ReelsMagician">
  <!-- No theme variant here: the Appearance setting picks it (AppTheme.cs), the system's own by
       default. -->
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://ReelsMagician/Assets/Theme.axaml" />
  </Application.Styles>
</Application>
