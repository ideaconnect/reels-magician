<!--
  The app's look on top of Avalonia's Fluent theme (dark). Colours match the WPF version;
  fonts are left to the system, so Windows shows Segoe UI and Linux its own UI font.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="using:Avalonia.Dialogs">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Fluent reads its accent from these. -->
      <Color x:Key="SystemAccentColor">#6C7BFF</Color>
      <Color x:Key="SystemAccentColorLight1">#7C89FF</Color>
      <Color x:Key="SystemAccentColorLight2">#8E99FF</Color>
      <Color x:Key="SystemAccentColorLight3">#A3ACFF</Color>
      <Color x:Key="SystemAccentColorDark1">#5D6CF0</Color>
      <Color x:Key="SystemAccentColorDark2">#4E5CE0</Color>
      <Color x:Key="SystemAccentColorDark3">#3F4CC8</Color>

      <SolidColorBrush x:Key="Bg" Color="#12121A" />
      <SolidColorBrush x:Key="Panel" Color="#1B1B26" />
      <SolidColorBrush x:Key="PanelAlt" Color="#22222F" />
      <SolidColorBrush x:Key="InputBg" Color="#15151F" />
      <SolidColorBrush x:Key="BorderBrush2" Color="#32323F" />
      <SolidColorBrush x:Key="TextBrush" Color="#ECECF2" />
      <SolidColorBrush x:Key="Muted" Color="#9A9AAC" />
      <SolidColorBrush x:Key="Accent" Color="#6C7BFF" />
      <SolidColorBrush x:Key="Good" Color="#3BD68A" />
      <SolidColorBrush x:Key="Warn" Color="#F5B94A" />
      <SolidColorBrush x:Key="WarnBg" Color="#2A2318" />

      <!-- Fluent's defaults are sized for touch; this is a dense desktop tool. -->
      <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
      <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
      <x:Double x:Key="TabItemMinHeight">38</x:Double>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{StaticResource Warn}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, Liberation Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Panels -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{StaticResource WarnBg}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{StaticResource BorderBrush2}" />
    <Setter Property="Margin" Value="4,4" />
  </Style>

  <!-- Inputs and lists -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource InputBg}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{StaticResource InputBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
  </Style>

  <!-- Reel proposals: a bordered card per item, the accent marking the chosen one. -->
  <Style Selector="ListBox.cards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.cards > ListBoxItem">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.cards > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#232338" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ListBox.cards > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#222230" />
  </Style>

  <!-- The cue table: compact rows, selection shown as a left accent rather than a fill. -->
  <Style Selector="ListBox.cues > ListBoxItem">
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style Selector="ListBox.cues > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#20203A" />
  </Style>
  <Style Selector="ListBox.cues TextBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <!-- The file picker is Avalonia's, with OK before Cancel. Laying that one row out right to left
       puts OK, the main action, on the right as everywhere in the app, without copying the
       picker's whole template; the buttons themselves stay left to right. -->
  <Style Selector="dialogs|ManagedFileChooser /template/ UniformGrid#Finalize">
    <Setter Property="FlowDirection" Value="RightToLeft" />
  </Style>
  <Style Selector="dialogs|ManagedFileChooser /template/ UniformGrid#Finalize > Button">
    <Setter Property="FlowDirection" Value="LeftToRight" />
  </Style>

  <!-- The activity log: plain lines, no selection chrome. -->
  <Style Selector="ListBox.log > ListBoxItem">
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
</Styles>
