<!--
  The app's look on top of Avalonia's Fluent theme (dark). Colours match the WPF version;
  fonts are left to the system, so Windows shows Segoe UI and Linux its own UI font.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ReelsMagician.App"
        xmlns:dialogs="using:Avalonia.Dialogs">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ReelsMagician/Assets/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- What a status means, in each theme: success, error, warning and info, for text and icons.
           They are theme resources, so they take DynamicResource. The light ones are checked
           against white cards, the dark ones against these dark panels, for 4.5:1 or more. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="SuccessBrush" Color="#3BD68A" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#F85149" />
          <SolidColorBrush x:Key="WarningBrush" Color="#F5B94A" />
          <SolidColorBrush x:Key="InfoBrush" Color="#4493F8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
          <SolidColorBrush x:Key="ErrorBrush" Color="#CF222E" />
          <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
          <SolidColorBrush x:Key="InfoBrush" Color="#0969DA" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Fluent reads its accent from these. -->
      <Color x:Key="SystemAccentColor">#6C7BFF</Color>
      <Color x:Key="SystemAccentColorLight1">#7C89FF</Color>
      <Color x:Key="SystemAccentColorLight2">#8E99FF</Color>
      <Color x:Key="SystemAccentColorLight3">#A3ACFF</Color>
      <Color x:Key="SystemAccentColorDark1">#5D6CF0</Color>
      <Color x:Key="SystemAccentColorDark2">#4E5CE0</Color>
      <Color x:Key="SystemAccentColorDark3">#3F4CC8</Color>

      <SolidColorBrush x:Key="Bg" Color="#12121A" />
      <SolidColorBrush x:Key="Panel" Color="#1B1B26" />
      <SolidColorBrush x:Key="PanelAlt" Color="#22222F" />
      <SolidColorBrush x:Key="InputBg" Color="#15151F" />
      <SolidColorBrush x:Key="BorderBrush2" Color="#32323F" />
      <SolidColorBrush x:Key="TextBrush" Color="#ECECF2" />
      <SolidColorBrush x:Key="Muted" Color="#9A9AAC" />
      <SolidColorBrush x:Key="Accent" Color="#6C7BFF" />
      <SolidColorBrush x:Key="WarnBg" Color="#2A2318" />

      <!-- Fluent's defaults are sized for touch; this is a dense desktop tool. -->
      <x:Double x:Key="ControlContentThemeFontSize">13</x:Double>
      <x:Double x:Key="TabItemHeaderFontSize">14</x:Double>
      <x:Double x:Key="TabItemMinHeight">38</x:Double>

      <!-- A Font Awesome icon (FaIcon.cs): the path unstretched on a canvas the size of the icons'
           shared viewBox, scaled to the control's size. At 16 px the glyph's em is 12.8 px tall. -->
      <ControlTheme x:Key="{x:Type local:FaIcon}" TargetType="local:FaIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
          <ControlTemplate>
            <Viewbox Stretch="Uniform">
              <Canvas Width="640" Height="640">
                <Path Data="{TemplateBinding Data}" Fill="{TemplateBinding Foreground}" Stretch="None" />
              </Canvas>
            </Viewbox>
          </ControlTemplate>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource Bg}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,0,0,6" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.warn">
    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, DejaVu Sans Mono, Liberation Mono, monospace" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Panels -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style Selector="Border.notice">
    <Setter Property="Background" Value="{StaticResource WarnBg}" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{StaticResource BorderBrush2}" />
    <Setter Property="Margin" Value="4,4" />
  </Style>

  <!-- A component's status on the Setup tab, told apart by shape as well as colour: a green check
       when it is there, a red X when it still has to download, and a muted dash for an optional
       one that is not installed, which is no error. -->
  <Style Selector="local|FaIcon.status">
    <Setter Property="Data" Value="{StaticResource fa-circle-xmark}" />
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>
  <Style Selector="local|FaIcon.status.ready">
    <Setter Property="Data" Value="{StaticResource fa-circle-check}" />
    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
  </Style>
  <Style Selector="local|FaIcon.status.optional">
    <Setter Property="Data" Value="{StaticResource fa-circle-minus}" />
    <Setter Property="Foreground" Value="{StaticResource Muted}" />
  </Style>

  <!-- Inputs and lists -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource InputBg}" />
  </Style>
  <Style Selector="ListBox">
    <Setter Property="Background" Value="{StaticResource InputBg}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="MinHeight" Value="6" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
  </Style>

  <!-- Reel proposals: a bordered card per item, the accent marking the chosen one. -->
  <Style Selector="ListBox.cards">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox.cards > ListBoxItem">
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Background" Value="{StaticResource Panel}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="ListBox.cards > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#232338" />
    <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
  </Style>
  <Style Selector="ListBox.cards > ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#222230" />
  </Style>

  <!-- The cue table: compact rows, selection shown as a left accent rather than a fill. -->
  <Style Selector="ListBox.cues > ListBoxItem">
    <Setter Property="Padding" Value="6,3" />
  </Style>
  <Style Selector="ListBox.cues > ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#20203A" />
  </Style>
  <Style Selector="ListBox.cues TextBox">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="6,4" />
  </Style>

  <!-- The file picker is Avalonia's, with OK before Cancel. Laying that one row out right to left
       puts OK, the main action, on the right as everywhere in the app, without copying the
       picker's whole template; the buttons themselves stay left to right. -->
  <Style Selector="dialogs|ManagedFileChooser /template/ UniformGrid#Finalize">
    <Setter Property="FlowDirection" Value="RightToLeft" />
  </Style>
  <Style Selector="dialogs|ManagedFileChooser /template/ UniformGrid#Finalize > Button">
    <Setter Property="FlowDirection" Value="LeftToRight" />
  </Style>

  <!-- The activity log: plain lines, no selection chrome. -->
  <Style Selector="ListBox.log > ListBoxItem">
    <Setter Property="Padding" Value="4,1" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- The support bar: each button in its service's own colours, Buy Me a Coffee's yellow and
       the pink heart of GitHub Sponsors on GitHub's dark button. -->
  <Style Selector="Button.coffee, Button.sponsor">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,7" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.coffee">
    <Setter Property="Background" Value="#FFDD00" />
    <Setter Property="Foreground" Value="#0D0C22" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.coffee:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#FFE53D" />
    <Setter Property="Foreground" Value="#0D0C22" />
  </Style>
  <Style Selector="Button.coffee:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E6C700" />
    <Setter Property="Foreground" Value="#0D0C22" />
  </Style>
  <Style Selector="Button.sponsor">
    <Setter Property="Background" Value="#21262D" />
    <Setter Property="Foreground" Value="#F0F6FC" />
    <Setter Property="BorderBrush" Value="#3D444D" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.sponsor:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#30363D" />
    <Setter Property="BorderBrush" Value="#DB61A2" />
    <Setter Property="Foreground" Value="#F0F6FC" />
  </Style>
  <Style Selector="Button.sponsor:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#282E33" />
    <Setter Property="BorderBrush" Value="#DB61A2" />
    <Setter Property="Foreground" Value="#F0F6FC" />
  </Style>
</Styles>
