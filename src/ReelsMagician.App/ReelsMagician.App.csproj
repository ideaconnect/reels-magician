<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\reelsmagician.ico</ApplicationIcon>
    <AssemblyName>ReelsMagician</AssemblyName>
    <RootNamespace>ReelsMagician.App</RootNamespace>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only the Windows and Wayland backends: the Linux build has no X11 path at all (docs/adr/0001). -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.5" />
    <PackageReference Include="Avalonia.HarfBuzz" Version="12.1.5" />
    <PackageReference Include="Avalonia.Win32" Version="12.1.5" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- The Windows installer's hooks. Keep vpk in .config/dotnet-tools.json at the same version:
         the installer it builds and this library speak to each other (InstallerChecks holds them). -->
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>
  <ItemGroup>
    <!-- The icons come from assets/AppIconBase.png through tools/make-icons.cs. -->
    <AvaloniaResource Include="Assets\reelsmagician.ico;Assets\reelsmagician-256.png;Assets\reelsmagician-128.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ReelsMagician.Core\ReelsMagician.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The interface's texts, in English, with Strings.pl.resx beside it. {l:Tr Key} reads them
         in XAML; the build generates the Strings class for code, so the compiler checks its keys. -->
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ReelsMagician.App.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    A published build carries the licences of everything it bundles (THIRD-PARTY-NOTICES.md):
    the app's own, the notices file, the texts kept in licenses/ for packages that ship none,
    and, below, the licence files the packages and the .NET runtime ship themselves.
  -->
  <ItemGroup>
    <None Include="..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\**\*" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Each package that puts a file in the build, and the runtime pack of a self-contained one,
       gets its LICENSE and THIRD-PARTY-NOTICES files copied to licenses/<package id>/. -->
  <Target Name="PublishPackageLicences" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_LicencePackage Include="%(ResolvedFileToPublish.NuGetPackageId)" Condition="'%(ResolvedFileToPublish.NuGetPackageId)' != ''">
        <Version>%(ResolvedFileToPublish.NuGetPackageVersion)</Version>
      </_LicencePackage>
      <!-- Runtime packs can live outside the NuGet folder, so they bring their own directory. -->
      <_UnusedRuntimePack Include="@(ResolvedRuntimePack)" Exclude="@(_LicencePackage)" />
      <_UsedRuntimePack Include="@(ResolvedRuntimePack)" Exclude="@(_UnusedRuntimePack)" />
      <_NuGetLicencePackage Include="@(_LicencePackage)" Exclude="@(ResolvedRuntimePack)" />
      <_NuGetLicencePackage>
        <PackageDirectory>$(NuGetPackageRoot)$([System.String]::Copy('%(Identity)').ToLowerInvariant())/%(Version)</PackageDirectory>
      </_NuGetLicencePackage>
      <_LicenceSource Include="@(_NuGetLicencePackage);@(_UsedRuntimePack)" />
      <_PackageLicenceFile Include="%(_LicenceSource.PackageDirectory)/LICENSE*;%(_LicenceSource.PackageDirectory)/THIRD-PARTY-NOTICES*">
        <PackageId>%(_LicenceSource.Identity)</PackageId>
      </_PackageLicenceFile>
      <_PackageLicenceFile>
        <RelativePath>licenses/%(PackageId)/%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </_PackageLicenceFile>
      <ResolvedFileToPublish Include="@(_PackageLicenceFile)" />
    </ItemGroup>
  </Target>
</Project>
