<Window x:Class="ReelsMagician.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ReelsMagician.App"
        xmlns:vm="clr-namespace:ReelsMagician.App.ViewModels"
        Title="ReelsMagician — reels from long videos"
        Height="900" Width="1360" MinHeight="680" MinWidth="1120"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Ideal">

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <Window.Resources>
    <local:EmptyStringToCollapsedConverter x:Key="EmptyToCollapsed" />
    <local:InverseBooleanConverter x:Key="Not" />
    <local:BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <local:ReadyToBrushConverter x:Key="ReadyBrush" />
    <local:ConfidenceToBrushConverter x:Key="ConfidenceBrush" />

    <DataTemplate x:Key="ComponentRow">
      <Grid Margin="0,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="320" />
          <ColumnDefinition Width="*" MinWidth="180" />
          <ColumnDefinition Width="140" />
          <ColumnDefinition Width="90" />
        </Grid.ColumnDefinitions>
        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                 Fill="{Binding IsReady, Converter={StaticResource ReadyBrush}}" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Hint}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="3" Text="{Binding StateText}" Style="{StaticResource Hint}"
                   VerticalAlignment="Center" />
        <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource Hint}"
                   VerticalAlignment="Center" HorizontalAlignment="Right" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ReelsMagician" Style="{StaticResource H1}" />
        <TextBlock Style="{StaticResource Hint}"
                   Text="Turn a long video into a vertical 1080×1920 reel: transcribe, review the subtitles, let Qwen pick the best stretch, keep the subject centred, and burn in captions." />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="{Binding GpuText}" Style="{StaticResource Hint}"
                   VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="420" />
        <Button Content="Open data folder" Command="{Binding OpenToolsFolderCommand}" />
      </StackPanel>
    </Grid>

    <!-- Main tabs -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTab}" Background="Transparent">

      <!-- ══ Setup ══ -->
      <TabItem Header="1 · Setup">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Required tools" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                           Text="Everything installs into your local app data folder — no admin rights, no system changes. Anything already on your PATH is reused instead of downloaded." />

                <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentRow}" />

                <TextBlock Text="{Binding MissingText}" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding BackendText}" Style="{StaticResource Hint}" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Content="Install everything missing" Style="{StaticResource Primary}"
                          Command="{Binding InstallCommand}" />
                  <Button Content="Re-check" Command="{Binding RefreshToolsCommand}" Margin="8,0,0,0" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Video links (optional)" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                           Text="Only needed to load a video from a link; local video files work without it. yt-dlp is a separate third-party tool that is not part of ReelsMagician, so it is not installed with the required tools, and you are asked before it is downloaded." />

                <ItemsControl ItemsSource="{Binding LinkComponents}" ItemTemplate="{StaticResource ComponentRow}" />

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Content="Download…" Command="{Binding InstallLinkToolsCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Models" Style="{StaticResource H2}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <Label Content="Speech recognition (Whisper)" />
                    <ComboBox ItemsSource="{Binding WhisperModels}"
                              SelectedItem="{Binding SelectedWhisperModel}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Text="{Binding SelectedWhisperModel.Notes}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Label Content="Segment analysis (Qwen, via llama.cpp)" />
                    <ComboBox ItemsSource="{Binding LlmModels}"
                              SelectedItem="{Binding SelectedLlmModel}"
                              DisplayMemberPath="DisplayName" />
                    <TextBlock Text="{Binding SelectedLlmModel.Notes}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                  </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="0,12,0,0"
                           Text="Qwen runs on llama.cpp's CUDA build on an NVIDIA card and its Vulkan build on AMD and Intel, so it uses the GPU either way. whisper.cpp publishes no Vulkan build for Windows, so it uses CUDA on an NVIDIA card and the fastest CPU build otherwise; point ReelsMagician at your own build in settings.json if you have one." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Free up space" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding DataFolderText}" Style="{StaticResource Hint}" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding CleanupItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,5">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto" />
                          <ColumnDefinition Width="230" />
                          <ColumnDefinition Width="*" MinWidth="200" />
                          <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Hint}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                  <Button Content="{Binding CleanupButtonText}" Style="{StaticResource Primary}"
                          Command="{Binding CleanupCommand}" />
                  <Button Content="Re-measure" Command="{Binding RefreshCleanupCommand}" Margin="8,0,0,0" />
                  <Button Content="Open data folder" Command="{Binding OpenToolsFolderCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="Only this folder is touched, and you are asked to confirm before anything is deleted. Working files are safe to clear at any time; removing the models or tools means downloading them again." />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ══ Source ══ -->
      <TabItem Header="2 · Source">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Video" Style="{StaticResource H2}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Choose an MP4 or paste a compatible video link. Links need yt-dlp, which you are asked about the first time, and are downloaded at the highest quality available up to your cap, preferring 4K." />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding SourceInput, UpdateSourceTrigger=PropertyChanged}"
                           VerticalContentAlignment="Center" />
                  <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0" />
                </Grid>

                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <Label Content="Download quality cap" />
                    <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding MaxHeight}" Width="150"
                              HorizontalAlignment="Left" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Label Content="Reel length" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                      </Grid.ColumnDefinitions>
                      <Slider Minimum="10" Maximum="120" TickFrequency="1"
                              Value="{Binding TargetSeconds}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Run Text="{Binding TargetSeconds, Mode=OneWay, StringFormat={}{0:0}}" />
                        <Run Text="s" />
                      </TextBlock>
                    </Grid>
                  </StackPanel>
                </Grid>

                <CheckBox Content="Use subtitles that come with the video when available (skips Whisper)"
                          IsChecked="{Binding UseProvidedSubtitles}" Margin="0,14,0,0" />

                <Button Content="Load source" Style="{StaticResource Primary}"
                        Command="{Binding LoadSourceCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Loaded video" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                <Border Margin="0,10,0,0" Padding="10" CornerRadius="6" Background="#2A2318"
                        Visibility="{Binding SourceWarning, Converter={StaticResource EmptyToCollapsed}}">
                  <TextBlock Text="{Binding SourceWarning}" TextWrapping="Wrap" Foreground="{StaticResource Warn}" />
                </Border>

                <Label Content="Topic used for the analysis" Margin="0,14,0,0" />
                <TextBox Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                           Text="Taken from the video title, or from the filename for a local file. Qwen scores every paragraph against this, so correct it if it is misleading." />

                <Button Content="Transcribe" Style="{StaticResource Primary}"
                        Command="{Binding TranscribeCommand}" HorizontalAlignment="Left" Margin="0,16,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ══ Subtitles ══ -->
      <TabItem Header="3 · Subtitles">
        <Grid Margin="0,12,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Text="{Binding TranscriptSummary}" Style="{StaticResource Hint}"
                     Margin="0,0,0,10" />

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Split" Command="{Binding SplitCueCommand}" />
            <Button Content="Merge with next" Command="{Binding MergeCueCommand}" Margin="8,0,0,0" />
            <Button Content="Delete" Command="{Binding DeleteCueCommand}" Margin="8,0,0,0" />
            <Border Width="1" Background="{StaticResource BorderBrush2}" Margin="12,2" />
            <Button Content="−100 ms" Command="{Binding ShiftEarlierCommand}" />
            <Button Content="+100 ms" Command="{Binding ShiftLaterCommand}" Margin="8,0,0,0" />
            <Border Width="1" Background="{StaticResource BorderBrush2}" Margin="12,2" />
            <Button Content="Import…" Command="{Binding ImportSubtitlesCommand}" />
            <Button Content="Export SRT…" Command="{Binding ExportSubtitlesCommand}" Margin="8,0,0,0" />
          </StackPanel>

          <DataGrid Grid.Row="2" ItemsSource="{Binding Subtitles}"
                    SelectedItem="{Binding SelectedSubtitle}"
                    AutoGenerateColumns="False" CanUserSortColumns="False"
                    VirtualizingPanel.IsVirtualizing="True">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Start" Binding="{Binding StartText, UpdateSourceTrigger=LostFocus}" Width="110" />
              <DataGridTextColumn Header="End" Binding="{Binding EndText, UpdateSourceTrigger=LostFocus}" Width="110" />
              <!-- Mode=OneWay is required, not cosmetic: DataGrid columns bind TwoWay by
                   default, and a TwoWay binding onto a get-only property throws. -->
              <DataGridTextColumn Header="Length" Binding="{Binding DurationText, Mode=OneWay}"
                                  IsReadOnly="True" Width="70" />
              <DataGridTextColumn Header="Words" Binding="{Binding WordCount, Mode=OneWay}"
                                  IsReadOnly="True" Width="60" />
              <DataGridTextColumn Header="Text" Binding="{Binding Text, UpdateSourceTrigger=LostFocus}" Width="*">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Foreground"
                            Value="{Binding LowConfidence, Converter={StaticResource ConfidenceBrush}}" />
                  </Style>
                </DataGridTextColumn.ElementStyle>
                <DataGridTextColumn.EditingElementStyle>
                  <Style TargetType="TextBox">
                    <Setter Property="AcceptsReturn" Value="False" />
                    <Setter Property="Background" Value="#15151F" />
                    <Setter Property="Foreground" Value="{StaticResource Text}" />
                  </Style>
                </DataGridTextColumn.EditingElementStyle>
              </DataGridTextColumn>
              <DataGridCheckBoxColumn Header="Edited" Binding="{Binding Edited, Mode=OneWay}"
                                      IsReadOnly="True" Width="60" />
            </DataGrid.Columns>
          </DataGrid>

          <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Analyse and pick the reel" Style="{StaticResource Primary}"
                    Command="{Binding AnalyzeCommand}" />
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="Amber text marks cues Whisper was unsure about. Edits are applied when you analyse." />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ══ Reel ══ -->
      <TabItem Header="4 · Reel">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.35*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding PlanSummary}"
                     Style="{StaticResource Hint}" Margin="0,0,0,10" />

          <ListBox Grid.Row="1" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate}"
                   HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="4" />
                <Setter Property="Background" Value="{StaticResource Panel}" />
                <Setter Property="Foreground" Value="{StaticResource Text}" />
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="6"
                              BorderThickness="1" BorderBrush="{StaticResource BorderBrush2}"
                              Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                          <Setter TargetName="b" Property="Background" Value="#232338" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="b" Property="Background" Value="#222230" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" TextWrapping="Wrap" Margin="0,0,0,2" />
                  <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" />
                  <TextBlock Text="{Binding ClipList}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Hook}" TextWrapping="Wrap" Margin="0,8,0,0"
                             FontFamily="Segoe UI Semibold"
                             Visibility="{Binding Hook, Converter={StaticResource EmptyToCollapsed}}" />
                  <TextBlock Text="{Binding Reason}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Preview}" Style="{StaticResource Hint}" Margin="0,8,0,0"
                             FontStyle="Italic" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Subject tracking" Style="{StaticResource H2}" />
              <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,0,0,10"
                         Text="Each clip is sampled frame by frame. A face in the foreground wins; failing that a body; failing that the most visually dominant region — so a product or a landscape stays centred too." />
              <ItemsControl ItemsSource="{Binding ClipFramings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{StaticResource PanelAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                      <StackPanel>
                        <DockPanel>
                          <TextBlock Text="{Binding Label}" FontFamily="Segoe UI Semibold" />
                          <TextBlock Text="{Binding SubjectText}" HorizontalAlignment="Right"
                                     Foreground="{StaticResource Accent}" />
                        </DockPanel>
                        <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding TrackingText}" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        <!-- Run.Text binds TwoWay by default, which throws on a get-only
                             property; every Run binding here must say OneWay. -->
                        <TextBlock Style="{StaticResource Hint}">
                          <Run Text="Crop " /><Run Text="{Binding CropText, Mode=OneWay}" />
                          <Run Text="  ·  " /><Run Text="{Binding DurationText, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
          </Border>

          <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Plan framing for this reel" Style="{StaticResource Primary}"
                    Command="{Binding FramingCommand}" />
            <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                       Text="Choosing a different reel clears the framing, so re-run this after switching." />
          </StackPanel>
        </Grid>
      </TabItem>

      <!-- ══ Captions ══ -->
      <TabItem Header="5 · Captions">
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
          </Grid.ColumnDefinitions>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel DataContext="{Binding StyleEditor}">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Preset" Style="{StaticResource H2}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding DataContext.Presets, RelativeSource={RelativeSource AncestorType=Window}}"
                              SelectedItem="{Binding DataContext.SelectedPreset, RelativeSource={RelativeSource AncestorType=Window}}"
                              DisplayMemberPath="Name" />
                    <Button Grid.Column="1" Content="Apply preset" Margin="8,0,0,0"
                            Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Caption style" Style="{StaticResource H2}" />

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Mode" />
                      <ComboBox ItemsSource="{x:Static vm:StyleEditorViewModel.Modes}" SelectedItem="{Binding Mode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Label Content="Entrance animation" />
                      <ComboBox ItemsSource="{x:Static vm:StyleEditorViewModel.Animations}" SelectedItem="{Binding Animation}" />
                    </StackPanel>
                  </Grid>

                  <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12"
                             Text="Plain text draws one static line per caption. Word highlight recolours and enlarges each word exactly as it is spoken, the way CapCut and Filmora do it." />

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="2*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Font" />
                      <ComboBox ItemsSource="{Binding AvailableFonts}" SelectedItem="{Binding FontName}"
                                IsEditable="True" Text="{Binding FontName}" MaxDropDownHeight="280" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Label Content="Size" />
                      <TextBox Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <CheckBox Content="Bold" IsChecked="{Binding Bold}" Margin="0,0,16,0" />
                    <CheckBox Content="Italic" IsChecked="{Binding Italic}" Margin="0,0,16,0" />
                    <CheckBox Content="UPPERCASE" IsChecked="{Binding Uppercase}" />
                  </StackPanel>

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Text colour" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding PrimaryColor, UpdateSourceTrigger=LostFocus}" />
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0" CornerRadius="4"
                                Background="{Binding PrimaryBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush2}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" IsEnabled="{Binding IsHighlightMode}">
                      <Label Content="Spoken-word colour" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding HighlightColor, UpdateSourceTrigger=LostFocus}" />
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0" CornerRadius="4"
                                Background="{Binding HighlightBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush2}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Outline colour" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding OutlineColor, UpdateSourceTrigger=LostFocus}" />
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0" CornerRadius="4"
                                Background="{Binding OutlineBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush2}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Label Content="Outline width" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="20" Value="{Binding OutlineWidth}" TickFrequency="0.5" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding OutlineWidth, StringFormat={}{0:0.#}}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Shadow depth" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="12" Value="{Binding ShadowDepth}" TickFrequency="0.5" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding ShadowDepth, StringFormat={}{0:0.#}}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" IsEnabled="{Binding IsHighlightMode}">
                      <Label Content="Spoken-word emphasis" />
                      <ComboBox ItemsSource="{x:Static vm:StyleEditorViewModel.Emphases}"
                                SelectedItem="{Binding Emphasis}" />
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center"
                               Text="Colour recolours the spoken word and nothing moves. Grow also enlarges it — vertically only, so the line never changes width and the caption stays put." />
                    <StackPanel Grid.Column="2">
                      <Label Content="Grow amount" />
                      <Grid IsEnabled="{Binding GrowsWord}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="1" Maximum="1.35" Value="{Binding HighlightScale}" TickFrequency="0.01" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding HighlightScale, StringFormat={}{0:0.00}×}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <CheckBox Content="Draw a filled box behind the text instead of an outline"
                            IsChecked="{Binding BackgroundBox}" Margin="0,0,0,8" />
                  <Grid Margin="0,0,0,10" IsEnabled="{Binding BackgroundBox}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Box colour" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=LostFocus}" />
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0" CornerRadius="4"
                                Background="{Binding BackgroundBrush}" BorderThickness="1"
                                BorderBrush="{StaticResource BorderBrush2}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Label Content="Box opacity" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="1" Value="{Binding BackgroundOpacity}" TickFrequency="0.05" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding BackgroundOpacity, StringFormat={}{0:0.00}}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Height on screen (% from top)" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="10" Maximum="92" Value="{Binding VerticalPositionPercent}" TickFrequency="1" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding VerticalPositionPercent, StringFormat={}{0:0}%}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Label Content="Words per caption" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="1" Maximum="12" Value="{Binding MaxWordsPerCaption}" TickFrequency="1" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding MaxWordsPerCaption}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Time on screen" Style="{StaticResource H2}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <Label Content="Shortest a line may stay up" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0.3" Maximum="3" Value="{Binding MinCaptionSeconds}" TickFrequency="0.1" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding MinCaptionSeconds, StringFormat={}{0:0.0}s}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <Label Content="Fastest reading rate" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="52" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="10" Maximum="45" Value="{Binding MaxReadingCharsPerSecond}" TickFrequency="1" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding MaxReadingCharsPerSecond, StringFormat={}{0:0} cps}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                             Text="A line that cannot get this much time is joined to its neighbour rather than flashing past — the words keep their own timings, so the highlight stays in sync and only the line break moves. Broadcast specs put the floor at 0.8–1.0s; burned-in captions can read faster because you also hear the words." />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Transitions" Style="{StaticResource H2}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Slider Minimum="20" Maximum="350" TickFrequency="5"
                            Value="{Binding DataContext.CrossfadeMs, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding DataContext.CrossfadeMs, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:0} ms}" />
                  </Grid>
                  <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                             Text="{Binding DataContext.CrossfadeHint, RelativeSource={RelativeSource AncestorType=Window}}" />
                  <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                             Text="The audio is crossfaded by the same amount, which keeps sound and picture locked together across every cut." />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource H2}" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <Button Content="Refresh preview" Command="{Binding RefreshPreviewCommand}" />
              <TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource Hint}" Margin="0,8,0,0" />
            </StackPanel>
            <Border Background="#0D0D14" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource BorderBrush2}" Padding="8">
              <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ══ Render ══ -->
      <TabItem Header="6 · Render">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
          <StackPanel>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Output" Style="{StaticResource H2}" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                           VerticalContentAlignment="Center" />
                  <Button Grid.Column="1" Content="Choose folder…" Command="{Binding BrowseOutputCommand}"
                          Margin="8,0,0,0" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                  <Button Content="Render the reel" Style="{StaticResource Primary}"
                          Command="{Binding RenderCommand}" />
                  <Button Content="Show in Explorer" Command="{Binding OpenOutputCommand}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                           Text="Renders 1080×1920 H.264 at 30 fps with AAC audio, normalised to −14 LUFS — the loudness target the social platforms use." />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Activity" Style="{StaticResource H2}" />
                <ListBox ItemsSource="{Binding Log}" Height="360" FontFamily="Cascadia Mono, Consolas"
                         FontSize="12" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="Padding" Value="2,1" />
                      <Setter Property="Foreground" Value="{StaticResource Muted}" />
                      <Setter Property="Background" Value="Transparent" />
                    </Style>
                  </ListBox.ItemContainerStyle>
                </ListBox>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Status bar -->
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
          <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="100"
                       Value="{Binding Progress, Mode=OneWay}"
                       IsIndeterminate="{Binding Indeterminate}"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="12,0,0,0"
                VerticalAlignment="Center"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
      </Grid>
    </Border>
  </Grid>
</Window>
