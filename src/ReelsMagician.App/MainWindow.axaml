<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ReelsMagician.App"
        xmlns:vm="using:ReelsMagician.App.ViewModels"
        xmlns:core="using:ReelsMagician.Core.Toolchain"
        xmlns:rendering="using:ReelsMagician.Core.Rendering"
        x:Class="ReelsMagician.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ReelsMagician — reels from long videos"
        Width="1360" Height="900" MinWidth="1120" MinHeight="680"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- The status icon carries the state on its own, by shape as well as colour (Theme.axaml),
         and names it for screen readers; the state text beside it stays. -->
    <DataTemplate x:Key="ComponentRow" x:DataType="vm:ComponentRowViewModel">
      <StackPanel Margin="0,4">
        <Grid ColumnDefinitions="24,320,*,140,90">
          <local:FaIcon Classes="status" Classes.ready="{Binding IsReady}" Classes.optional="{Binding IsOptional}"
                        AutomationProperties.Name="{Binding StateText}"
                        HorizontalAlignment="Left" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                     Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="hint" TextWrapping="NoWrap"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Text="{Binding StateText}" Classes="hint" VerticalAlignment="Center" />
          <TextBlock Grid.Column="4" Text="{Binding SizeText}" Classes="hint"
                     VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <!-- Under the name, a component's warning, such as a Fallback build, in a warning box. -->
        <local:InfoBox Kind="Warning" Text="{Binding Warning}" Margin="24,6,0,2"
                       IsVisible="{Binding Warning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </DataTemplate>

    <!-- A model in a Setup drop-down: an amber triangle before its name when it probably won't
         fit this computer's memory. The triangle is decoration; the item's accessible name says it. -->
    <DataTemplate x:Key="ModelOption" x:DataType="vm:ModelOptionViewModel">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <local:FaIcon Data="{StaticResource fa-triangle-exclamation}" Foreground="{DynamicResource WarningBrush}"
                      Width="14" Height="14" VerticalAlignment="Center" IsVisible="{Binding MayNotFit}"
                      AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>

    <!-- A licence on the About tab: the component and what it is for, its licence and, for a
         download, whether it is on this machine, then its source and the text the build carries.
         The button columns share their widths across rows (the card's IsSharedSizeScope). -->
    <DataTemplate x:Key="LicenceRow" x:DataType="vm:LicenceRowViewModel">
      <Border BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0" Padding="0,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="SourceButton" />
            <ColumnDefinition Width="Auto" SharedSizeGroup="LicenceButton" />
          </Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Purpose}" Classes="hint" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Licence}" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding HasInstallState}">
              <local:FaIcon Classes="status" Classes.ready="{Binding IsPresent}" Classes.optional="{Binding !IsPresent}"
                            Width="14" Height="14" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding InstallText}" />
              <TextBlock Text="{Binding InstallText}" Classes="hint" VerticalAlignment="Center" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="2" Content="Source" local:FaIcon.ButtonIcon="{StaticResource fa-arrow-up-right-from-square}"
                  Command="{Binding OpenSourceCommand}" ToolTip.Tip="{Binding Source}"
                  AutomationProperties.Name="{Binding SourceAccessibleName}" VerticalAlignment="Center" />
          <Button Grid.Column="3" Content="View licence" local:FaIcon.ButtonIcon="{StaticResource fa-file-lines}"
                  Command="{Binding ViewLicenceCommand}" IsVisible="{Binding HasTexts}" Margin="8,0,0,0"
                  AutomationProperties.Name="{Binding LicenceAccessibleName}" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.DataTemplates>
    <!-- A step's chip in the strip: its number in a badge, a check once its output exists, and
         its name. The styles in Assets/Theme.axaml colour it by state. -->
    <DataTemplate DataType="vm:StepViewModel">
      <StackPanel Classes="step" Classes.done="{Binding IsDone}" Classes.current="{Binding IsCurrent}"
                  Classes.upcoming="{Binding IsUpcoming}" Orientation="Horizontal" Spacing="8">
        <Border Classes="badge" Width="22" Height="22" CornerRadius="11" BorderThickness="1.5"
                VerticalAlignment="Center">
          <Panel>
            <TextBlock Classes="badge-number" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !IsDone}" />
            <local:FaIcon Classes="badge-check" Data="{StaticResource fa-check}" Width="16" Height="16"
                          HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsDone}" />
          </Panel>
        </Border>
        <Grid VerticalAlignment="Center">
          <!-- Holds the width of the bold label, so selecting a step never shifts the strip. -->
          <TextBlock Text="{Binding Title}" FontWeight="Bold" Opacity="0" />
          <TextBlock Classes="step-title" Text="{Binding Title}" HorizontalAlignment="Center" />
        </Grid>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid Margin="16" RowDefinitions="Auto,*,Auto,Auto">

    <!-- Header: the app's icon, then its name and what it does. -->
    <Grid Grid.Row="0" Margin="0,0,0,10" ColumnDefinitions="Auto,*,Auto">
      <!-- Decoration beside the name, hidden from screen readers. 128 px of image drawn at 40 px
           stays sharp up to 300 % scaling. -->
      <Image Source="/Assets/reelsmagician-128.png" Width="40" Height="40" Margin="0,0,12,0"
             VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality"
             AutomationProperties.AccessibilityView="Raw" />
      <StackPanel Grid.Column="1">
        <TextBlock Text="ReelsMagician" Classes="h1" />
        <TextBlock Classes="hint"
                   Text="Turn a long video into a vertical 1080×1920 reel: transcribe, review the subtitles, let Qwen pick the best stretch, keep the subject centred, and burn in captions." />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
        <TextBlock Text="{Binding GpuText}" Classes="hint" VerticalAlignment="Center" MaxWidth="460" />
        <!-- The theme: follow the system, light or dark, applied at once and remembered. -->
        <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="2" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <RadioButton Theme="{StaticResource Segment}" GroupName="Appearance" IsChecked="{Binding FollowsSystemTheme}"
                         ToolTip.Tip="Follow the system's light or dark setting"
                         AutomationProperties.Name="Theme: follow the system">
              <local:FaIcon Data="{StaticResource fa-desktop}" />
            </RadioButton>
            <RadioButton Theme="{StaticResource Segment}" GroupName="Appearance" IsChecked="{Binding UsesLightTheme}"
                         ToolTip.Tip="Light theme" AutomationProperties.Name="Theme: light">
              <local:FaIcon Data="{StaticResource fa-sun}" />
            </RadioButton>
            <RadioButton Theme="{StaticResource Segment}" GroupName="Appearance" IsChecked="{Binding UsesDarkTheme}"
                         ToolTip.Tip="Dark theme" AutomationProperties.Name="Theme: dark">
              <local:FaIcon Data="{StaticResource fa-moon}" />
            </RadioButton>
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Main tabs: a stepper. The strip is a bar of its own with the page it opens framed under
         it, and each step is a chip showing its number, or a check once its output exists. -->
    <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTab}"
                Theme="{StaticResource StepStrip}" ItemContainerTheme="{StaticResource StepTab}">
      <!-- The steps run from the left; Cleanup and About sit together on the right, apart from
           them, in tab order, so the arrow keys move through the strip as it reads. -->
      <TabControl.ItemsPanel>
        <ItemsPanelTemplate>
          <local:StepStripPanel />
        </ItemsPanelTemplate>
      </TabControl.ItemsPanel>

      <!-- ══ Setup ══ -->
      <TabItem Header="{Binding SetupStep}" AutomationProperties.Name="{Binding SetupStep.AccessibleName}">
        <!-- Every scrolling area fades its edges where there is more to scroll to (ScrollShadow.cs).
             On the pages, 8 px of bottom padding and the last card's 12 px margin leave the last
             card a strip's height clear of the bottom edge at the end of the page. -->
        <ScrollViewer Padding="0,12,8,8" local:ScrollShadow.IsEnabled="True">
          <StackPanel>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Required tools" Classes="h2" />
                <local:InfoBox Margin="0,0,0,10"
                               Text="Everything installs into the app's own data folder: no admin rights, no system changes. Anything already on your PATH is reused instead of downloaded." />

                <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource ComponentRow}" />

                <TextBlock Text="{Binding MissingText}" Classes="hint" Margin="0,12,0,0" />
                <TextBlock Text="{Binding BackendText}" Classes="hint" Margin="0,4,0,0" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0" Spacing="8">
                  <Button Content="Re-check" local:FaIcon.ButtonIcon="{StaticResource fa-rotate}" Command="{Binding RefreshToolsCommand}" />
                  <Button Content="Install everything missing" Classes="accent" local:FaIcon.ButtonIcon="{StaticResource fa-download}"
                          Command="{Binding InstallCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Video links (optional)" Classes="h2" />
                <local:InfoBox Margin="0,0,0,10"
                               Text="Only needed to load a video from a link; local video files work without it. yt-dlp is a separate third-party tool that is not part of ReelsMagician, so it is not installed with the required tools, and you are asked before it is downloaded." />

                <ItemsControl ItemsSource="{Binding LinkComponents}" ItemTemplate="{StaticResource ComponentRow}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                  <Button Content="Download…" local:FaIcon.ButtonIcon="{StaticResource fa-download}" Command="{Binding InstallLinkToolsCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Models" Classes="h2" />
                <!-- A model that probably won't fit this computer's memory has an amber triangle in
                     its drop-down, and the chosen one a warning box under it (issue #54). Under each
                     drop-down, what the chosen model needs, at the context it will get. -->
                <Grid ColumnDefinitions="*,16,*">
                  <StackPanel>
                    <TextBlock Text="Speech recognition (Whisper)" Classes="label" />
                    <ComboBox ItemsSource="{Binding WhisperOptions}" SelectedItem="{Binding SelectedWhisperOption}"
                              ItemTemplate="{StaticResource ModelOption}" HorizontalAlignment="Stretch">
                      <ComboBox.Styles>
                        <Style Selector="ComboBoxItem" x:DataType="vm:ModelOptionViewModel">
                          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                      </ComboBox.Styles>
                    </ComboBox>
                    <TextBlock Text="{Binding WhisperModelNotes}" Classes="hint" Margin="0,6,0,0" />
                    <local:InfoBox Kind="Warning" Text="{Binding WhisperFitWarning}" Margin="0,8,0,0"
                                   IsVisible="{Binding WhisperFitWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Segment analysis (Qwen, via llama.cpp)" Classes="label" />
                    <ComboBox ItemsSource="{Binding LlmOptions}" SelectedItem="{Binding SelectedLlmOption}"
                              ItemTemplate="{StaticResource ModelOption}" HorizontalAlignment="Stretch">
                      <ComboBox.Styles>
                        <Style Selector="ComboBoxItem" x:DataType="vm:ModelOptionViewModel">
                          <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                        </Style>
                      </ComboBox.Styles>
                    </ComboBox>
                    <TextBlock Text="{Binding LlmModelNotes}" Classes="hint" Margin="0,6,0,0" />
                    <local:InfoBox Kind="Warning" Text="{Binding LlmFitWarning}" Margin="0,8,0,0"
                                   IsVisible="{Binding LlmFitWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Grid>
                <local:InfoBox Margin="0,12,0,0" Text="{Binding ModelsHint}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ══ Source ══ -->
      <TabItem Header="{Binding SourceStep}" AutomationProperties.Name="{Binding SourceStep.AccessibleName}">
        <ScrollViewer Padding="0,12,8,8" local:ScrollShadow.IsEnabled="True">
          <StackPanel>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Video" Classes="h2" />
                <local:InfoBox Margin="0,0,0,10"
                               Text="Choose an MP4 or paste a compatible video link. Links need yt-dlp, which you are asked about the first time, and are downloaded at the highest quality available up to your cap, preferring 4K." />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding SourceInput}" VerticalContentAlignment="Center" />
                  <Button Grid.Column="1" Content="Browse…" local:FaIcon.ButtonIcon="{StaticResource fa-folder-open}"
                          Command="{Binding BrowseSourceCommand}" Margin="8,0,0,0" />
                </Grid>

                <Grid Margin="0,14,0,0" ColumnDefinitions="Auto,24,*">
                  <StackPanel>
                    <TextBlock Text="Download quality cap" Classes="label" />
                    <ComboBox ItemsSource="{Binding QualityOptions}" SelectedItem="{Binding MaxHeight}" Width="150" />
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Reel length" Classes="label" />
                    <Grid ColumnDefinitions="*,70">
                      <Slider Minimum="10" Maximum="120" TickFrequency="1" Value="{Binding TargetSeconds}" />
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                 Text="{Binding TargetSeconds, StringFormat={}{0:0}s}" />
                    </Grid>
                  </StackPanel>
                </Grid>

                <CheckBox Content="Use subtitles that come with the video when available (skips Whisper)"
                          IsChecked="{Binding UseProvidedSubtitles}" Margin="0,14,0,0" />

                <Button Content="Load source" Classes="accent" Command="{Binding LoadSourceCommand}"
                        HorizontalAlignment="Right" Margin="0,16,0,0" />
              </StackPanel>
            </Border>

            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Loaded video" Classes="h2" />
                <TextBlock Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                <local:InfoBox Kind="Warning" Text="{Binding SourceWarning}" Margin="0,10,0,0"
                               IsVisible="{Binding SourceWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Text="Topic used for the analysis" Classes="label" Margin="0,14,0,4" />
                <TextBox Text="{Binding Topic}" />
                <!-- The note beside the button, as on Subtitles and Reel, so a page with a
                     warning still fits the default window. -->
                <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
                  <local:InfoBox VerticalAlignment="Center" Margin="0,0,12,0"
                                 Text="Taken from the video title, or from the filename for a local file. Qwen scores every paragraph against this, so correct it if it is misleading." />
                  <Button Grid.Column="1" Content="Transcribe" Classes="accent" Command="{Binding TranscribeCommand}"
                          VerticalAlignment="Center" />
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ══ Subtitles ══ -->
      <TabItem Header="{Binding SubtitlesStep}" AutomationProperties.Name="{Binding SubtitlesStep.AccessibleName}">
        <Grid Margin="0,12,0,0" RowDefinitions="Auto,Auto,Auto,*,Auto">

          <TextBlock Grid.Row="0" Text="{Binding TranscriptSummary}" Classes="hint" Margin="0,0,0,10" />

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
            <Button Content="Split" local:FaIcon.ButtonIcon="{StaticResource fa-scissors}" Command="{Binding SplitCueCommand}" />
            <Button Content="Merge with next" local:FaIcon.ButtonIcon="{StaticResource fa-code-merge}" Command="{Binding MergeCueCommand}" />
            <Button Content="Delete" local:FaIcon.ButtonIcon="{StaticResource fa-trash-can}" Command="{Binding DeleteCueCommand}" />
            <Border Classes="divider" />
            <Button Content="−100 ms" local:FaIcon.ButtonIcon="{StaticResource fa-backward-step}" Command="{Binding ShiftEarlierCommand}" />
            <Button Content="+100 ms" local:FaIcon.ButtonIcon="{StaticResource fa-forward-step}" Command="{Binding ShiftLaterCommand}" />
            <Border Classes="divider" />
            <Button Content="Import…" local:FaIcon.ButtonIcon="{StaticResource fa-file-import}" Command="{Binding ImportSubtitlesCommand}" />
            <Button Content="Export SRT…" local:FaIcon.ButtonIcon="{StaticResource fa-file-export}" Command="{Binding ExportSubtitlesCommand}" />
          </StackPanel>

          <!-- Column headings for the cue rows below; the widths must match the row template. -->
          <Border Grid.Row="2" Background="{DynamicResource PanelAlt}" CornerRadius="6,6,0,0" Padding="12,7">
            <Grid ColumnDefinitions="118,118,64,54,*,60">
              <TextBlock Text="Start" Classes="label" Margin="0" />
              <TextBlock Grid.Column="1" Text="End" Classes="label" Margin="0" />
              <TextBlock Grid.Column="2" Text="Length" Classes="label" Margin="0" />
              <TextBlock Grid.Column="3" Text="Words" Classes="label" Margin="0" />
              <TextBlock Grid.Column="4" Text="Text" Classes="label" Margin="0" />
              <TextBlock Grid.Column="5" Text="Edited" Classes="label" Margin="0" />
            </Grid>
          </Border>

          <!-- A plain list of editable rows, virtualised, rather than a data grid (docs/adr/0001). -->
          <ListBox x:Name="SubtitleList" Grid.Row="3" Classes="cues" CornerRadius="0,0,6,6"
                   ItemsSource="{Binding Subtitles}" SelectedItem="{Binding SelectedSubtitle}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   local:ScrollShadow.IsEnabled="True" local:ScrollShadow.Surface="{DynamicResource InputBg}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SubtitleRowViewModel">
                <Grid ColumnDefinitions="118,118,64,54,*,60">
                  <TextBox Text="{Binding StartText, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" />
                  <TextBox Grid.Column="1" Text="{Binding EndText, UpdateSourceTrigger=LostFocus}" Margin="0,0,6,0" />
                  <TextBlock Grid.Column="2" Text="{Binding DurationText}" Classes="hint" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding WordCount}" Classes="hint" VerticalAlignment="Center" />
                  <TextBox Grid.Column="4" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" TextWrapping="Wrap"
                           AcceptsReturn="False" Classes.low="{Binding LowConfidence}" />
                  <TextBlock Grid.Column="5" Text="edited" Classes="hint" VerticalAlignment="Center"
                             Margin="8,0,0,0" IsVisible="{Binding Edited}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Grid.Row="4" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <local:InfoBox VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="Amber text marks cues Whisper was unsure about. Edits are applied when you analyse." />
            <Button Grid.Column="1" Content="Analyse and pick the reel" Classes="accent" Command="{Binding AnalyzeCommand}" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- ══ Reel ══ -->
      <TabItem Header="{Binding ReelStep}" AutomationProperties.Name="{Binding ReelStep.AccessibleName}">
        <Grid Margin="0,12,0,0" ColumnDefinitions="1.35*,16,*" RowDefinitions="Auto,*,Auto">

          <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{Binding PlanSummary}" Classes="hint" Margin="0,0,0,10" />

          <ListBox Grid.Row="1" Classes="cards" ItemsSource="{Binding Candidates}"
                   SelectedItem="{Binding SelectedCandidate}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" local:ScrollShadow.IsEnabled="True">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:CandidateViewModel">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" Classes="h2" TextWrapping="Wrap" Margin="0,0,0,2" />
                  <TextBlock Text="{Binding Summary}" Classes="hint" />
                  <TextBlock Text="{Binding ClipList}" Classes="hint" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Hook}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"
                             IsVisible="{Binding Hook, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  <TextBlock Text="{Binding Reason}" Classes="hint" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Preview}" Classes="hint" Margin="0,8,0,0" FontStyle="Italic" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="1" Grid.Column="2" Classes="card" Margin="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Subject tracking" Classes="h2" />
              <local:InfoBox DockPanel.Dock="Top" Margin="0,0,0,10"
                             Text="Each clip is sampled frame by frame. A face in the foreground wins; failing that a body; failing that the most visually dominant region — so a product or a landscape stays centred too." />
              <ScrollViewer local:ScrollShadow.IsEnabled="True" local:ScrollShadow.Surface="{DynamicResource Panel}">
                <ItemsControl ItemsSource="{Binding ClipFramings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClipFramingViewModel">
                      <Border Background="{DynamicResource PanelAlt}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SubjectText}" Foreground="{DynamicResource Accent}" />
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                          </DockPanel>
                          <TextBlock Text="{Binding TimeLabel}" Classes="hint" Margin="0,4,0,0" />
                          <TextBlock Text="{Binding TrackingText}" Classes="hint" />
                          <TextBlock Classes="hint">
                            <TextBlock.Text>
                              <MultiBinding StringFormat="Crop {0}  ·  {1}">
                                <Binding Path="CropText" />
                                <Binding Path="DurationText" />
                              </MultiBinding>
                            </TextBlock.Text>
                          </TextBlock>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Border>

          <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <local:InfoBox VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="Choosing a different reel clears the framing, so re-run this after switching." />
            <Button Grid.Column="1" Content="Plan framing for this reel" Classes="accent" Command="{Binding FramingCommand}" />
          </Grid>
        </Grid>
      </TabItem>

      <!-- ══ Captions ══ -->
      <TabItem Header="{Binding CaptionsStep}" AutomationProperties.Name="{Binding CaptionsStep.AccessibleName}">
        <Grid Margin="0,12,0,0" ColumnDefinitions="*,16,380">

          <ScrollViewer Padding="0,0,8,8" local:ScrollShadow.IsEnabled="True">
            <StackPanel>
              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Preset" Classes="h2" />
                  <Grid ColumnDefinitions="*,Auto">
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              HorizontalAlignment="Stretch">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="rendering:SubtitleStyle">
                          <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="1" Content="Apply preset" Margin="8,0,0,0" Command="{Binding ApplyPresetCommand}" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Caption style" Classes="h2" />

                  <Grid Margin="0,0,0,10" ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Text="Mode" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:StyleEditorViewModel.Modes}"
                                SelectedItem="{Binding StyleEditor.Mode}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Entrance animation" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:StyleEditorViewModel.Animations}"
                                SelectedItem="{Binding StyleEditor.Animation}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Grid>

                  <local:InfoBox Margin="0,0,0,12"
                                 Text="Plain text draws one static line per caption. Word highlight recolours and enlarges each word exactly as it is spoken, the way CapCut and Filmora do it." />

                  <Grid Margin="0,0,0,10" ColumnDefinitions="2*,12,*">
                    <StackPanel>
                      <TextBlock Text="Font" Classes="label" />
                      <!-- Typed or picked: a preset may name a font this computer does not have. -->
                      <AutoCompleteBox ItemsSource="{Binding StyleEditor.AvailableFonts}"
                                       Text="{Binding StyleEditor.FontName, Mode=TwoWay}"
                                       FilterMode="ContainsOrdinal" MinimumPrefixLength="0" MaxDropDownHeight="280" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Size" Classes="label" />
                      <TextBox Text="{Binding StyleEditor.FontSize, UpdateSourceTrigger=LostFocus}" />
                    </StackPanel>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,12" Spacing="16">
                    <CheckBox Content="Bold" IsChecked="{Binding StyleEditor.Bold}" />
                    <CheckBox Content="Italic" IsChecked="{Binding StyleEditor.Italic}" />
                    <CheckBox Content="UPPERCASE" IsChecked="{Binding StyleEditor.Uppercase}" />
                  </StackPanel>

                  <Grid Margin="0,0,0,10" ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Text="Text colour" Classes="label" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding StyleEditor.PrimaryColor, UpdateSourceTrigger=LostFocus}" />
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0" CornerRadius="4" BorderThickness="1"
                                Background="{Binding StyleEditor.PrimaryBrush}" BorderBrush="{DynamicResource BorderBrush2}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" IsEnabled="{Binding StyleEditor.IsHighlightMode}">
                      <TextBlock Text="Spoken-word colour" Classes="label" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding StyleEditor.HighlightColor, UpdateSourceTrigger=LostFocus}" />
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0" CornerRadius="4" BorderThickness="1"
                                Background="{Binding StyleEditor.HighlightBrush}" BorderBrush="{DynamicResource BorderBrush2}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,0,0,10" ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Text="Outline colour" Classes="label" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding StyleEditor.OutlineColor, UpdateSourceTrigger=LostFocus}" />
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0" CornerRadius="4" BorderThickness="1"
                                Background="{Binding StyleEditor.OutlineBrush}" BorderBrush="{DynamicResource BorderBrush2}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Outline width" Classes="label" />
                      <Grid ColumnDefinitions="*,44">
                        <Slider Minimum="0" Maximum="20" TickFrequency="0.5" Value="{Binding StyleEditor.OutlineWidth}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StyleEditor.OutlineWidth, StringFormat={}{0:0.#}}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,0,0,10" ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Text="Shadow depth" Classes="label" />
                      <Grid ColumnDefinitions="*,44">
                        <Slider Minimum="0" Maximum="12" TickFrequency="0.5" Value="{Binding StyleEditor.ShadowDepth}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StyleEditor.ShadowDepth, StringFormat={}{0:0.#}}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2" IsEnabled="{Binding StyleEditor.IsHighlightMode}">
                      <TextBlock Text="Spoken-word emphasis" Classes="label" />
                      <ComboBox ItemsSource="{x:Static vm:StyleEditorViewModel.Emphases}"
                                SelectedItem="{Binding StyleEditor.Emphasis}" HorizontalAlignment="Stretch" />
                    </StackPanel>
                  </Grid>

                  <Grid Margin="0,0,0,10" ColumnDefinitions="*,12,*">
                    <!-- Beside a field, where a full box would make the card heavy: the compact form. -->
                    <local:InfoBox Classes="compact" VerticalAlignment="Center"
                                   Text="Colour recolours the spoken word and nothing moves. Grow also enlarges it — vertically only, so the line never changes width and the caption stays put." />
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Grow amount" Classes="label" />
                      <Grid ColumnDefinitions="*,44" IsEnabled="{Binding StyleEditor.GrowsWord}">
                        <Slider Minimum="1" Maximum="1.35" TickFrequency="0.01" Value="{Binding StyleEditor.HighlightScale}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StyleEditor.HighlightScale, StringFormat={}{0:0.00}×}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <CheckBox Content="Draw a filled box behind the text instead of an outline"
                            IsChecked="{Binding StyleEditor.BackgroundBox}" Margin="0,0,0,8" />
                  <Grid Margin="0,0,0,10" ColumnDefinitions="*,12,*" IsEnabled="{Binding StyleEditor.BackgroundBox}">
                    <StackPanel>
                      <TextBlock Text="Box colour" Classes="label" />
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding StyleEditor.BackgroundColor, UpdateSourceTrigger=LostFocus}" />
                        <Border Grid.Column="1" Width="30" Margin="6,0,0,0" CornerRadius="4" BorderThickness="1"
                                Background="{Binding StyleEditor.BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush2}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Box opacity" Classes="label" />
                      <Grid ColumnDefinitions="*,44">
                        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" Value="{Binding StyleEditor.BackgroundOpacity}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StyleEditor.BackgroundOpacity, StringFormat={}{0:0.00}}" />
                      </Grid>
                    </StackPanel>
                  </Grid>

                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Text="Height on screen (% from top)" Classes="label" />
                      <Grid ColumnDefinitions="*,44">
                        <Slider Minimum="10" Maximum="92" TickFrequency="1" Value="{Binding StyleEditor.VerticalPositionPercent}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StyleEditor.VerticalPositionPercent, StringFormat={}{0:0}%}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Words per caption" Classes="label" />
                      <Grid ColumnDefinitions="*,44">
                        <Slider Minimum="1" Maximum="12" TickFrequency="1" Value="{Binding StyleEditor.MaxWordsPerCaption}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StyleEditor.MaxWordsPerCaption}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Time on screen" Classes="h2" />
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel>
                      <TextBlock Text="Shortest a line may stay up" Classes="label" />
                      <Grid ColumnDefinitions="*,48">
                        <Slider Minimum="0.3" Maximum="3" TickFrequency="0.1" Value="{Binding StyleEditor.MinCaptionSeconds}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StyleEditor.MinCaptionSeconds, StringFormat={}{0:0.0}s}" />
                      </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Fastest reading rate" Classes="label" />
                      <Grid ColumnDefinitions="*,52">
                        <Slider Minimum="10" Maximum="45" TickFrequency="1" Value="{Binding StyleEditor.MaxReadingCharsPerSecond}" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{Binding StyleEditor.MaxReadingCharsPerSecond, StringFormat={}{0:0} cps}" />
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <local:InfoBox Margin="0,10,0,0"
                                 Text="A line that cannot get this much time is joined to its neighbour rather than flashing past — the words keep their own timings, so the highlight stays in sync and only the line break moves. Broadcast specs put the floor at 0.8–1.0s; burned-in captions can read faster because you also hear the words." />
                </StackPanel>
              </Border>

              <Border Classes="card">
                <StackPanel>
                  <TextBlock Text="Transitions" Classes="h2" />
                  <Grid ColumnDefinitions="*,60">
                    <Slider Minimum="20" Maximum="350" TickFrequency="5" Value="{Binding CrossfadeMs}" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Text="{Binding CrossfadeMs, StringFormat={}{0:0} ms}" />
                  </Grid>
                  <!-- One note for both lines: what this length does, then what it applies to. -->
                  <local:InfoBox Margin="0,8,0,0">
                    <local:InfoBox.Text>
                      <MultiBinding StringFormat="{}{0}&#x0a;The audio is crossfaded by the same amount, which keeps sound and picture locked together across every cut.">
                        <Binding Path="CrossfadeHint" />
                      </MultiBinding>
                    </local:InfoBox.Text>
                  </local:InfoBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="Preview" Classes="h2" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
              <Button Content="Refresh preview" local:FaIcon.ButtonIcon="{StaticResource fa-rotate}" Command="{Binding RefreshPreviewCommand}"
                      HorizontalAlignment="Right" />
              <TextBlock Text="{Binding PreviewStatus}" Classes="hint" Margin="0,8,0,0" />
            </StackPanel>
            <!-- Black in both themes: it stands in for the video. -->
            <Border Background="{DynamicResource VideoFrame}" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush2}" Padding="8">
              <Image Source="{Binding PreviewImage}" Stretch="Uniform"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- ══ Render ══ -->
      <TabItem Header="{Binding RenderStep}" AutomationProperties.Name="{Binding RenderStep.AccessibleName}">
        <ScrollViewer Padding="0,12,8,8" local:ScrollShadow.IsEnabled="True">
          <StackPanel>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Output" Classes="h2" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Text="{Binding OutputFolder}" VerticalContentAlignment="Center" />
                  <Button Grid.Column="1" Content="Choose folder…" local:FaIcon.ButtonIcon="{StaticResource fa-folder-open}"
                          Command="{Binding BrowseOutputCommand}" Margin="8,0,0,0" />
                </Grid>
                <!-- What the render produces, beside the buttons that make it. -->
                <Grid Margin="0,16,0,0" ColumnDefinitions="*,Auto">
                  <local:InfoBox VerticalAlignment="Center" Margin="0,0,12,0"
                                 Text="Renders 1080×1920 H.264 at 30 fps with AAC audio, normalised to −14 LUFS — the loudness target the social platforms use." />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button Content="Copy path" local:FaIcon.ButtonIcon="{StaticResource fa-copy}" Command="{Binding CopyOutputPathCommand}" />
                    <Button Content="Render the reel" Classes="accent" local:FaIcon.ButtonIcon="{StaticResource fa-film}" Command="{Binding RenderCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="card">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Activity" Classes="h2" />
                <!-- Scrolls inside the scrolling page: its strips stay inside its own border. -->
                <ListBox Classes="log" ItemsSource="{Binding Log}" Height="360"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         local:ScrollShadow.IsEnabled="True" local:ScrollShadow.Surface="{DynamicResource InputBg}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                      <TextBlock Text="{Binding}" Classes="mono" Foreground="{DynamicResource Muted}" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </DockPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ══ Cleanup: not a step, so it sits on the right of the strip, outlined and unnumbered ══ -->
      <TabItem Header="Cleanup" Classes="aside" DockPanel.Dock="Right" AutomationProperties.Name="Cleanup">
        <ScrollViewer Padding="0,12,8,8" local:ScrollShadow.IsEnabled="True">
          <StackPanel>
            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Free up space" Classes="h2" />
                <SelectableTextBlock Text="{Binding DataFolderText}" Foreground="{DynamicResource Muted}"
                                     FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10" />

                <ItemsControl ItemsSource="{Binding CleanupItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:CleanupRowViewModel">
                      <Grid Margin="0,5" ColumnDefinitions="Auto,230,*,100">
                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}"
                                  VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="hint" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="{Binding SizeText}" Classes="hint"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- What cleaning up touches, beside the buttons, so the page fits the smallest window. -->
                <Grid Margin="0,14,0,0" ColumnDefinitions="*,Auto">
                  <local:InfoBox VerticalAlignment="Center" Margin="0,0,12,0"
                                 Text="Only this folder is touched, and you are asked to confirm before anything is deleted. Working files are safe to clear at any time; removing the models or tools means downloading them again." />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <Button Content="Copy path" local:FaIcon.ButtonIcon="{StaticResource fa-copy}" Command="{Binding CopyDataFolderCommand}" />
                    <Button Content="Re-measure" local:FaIcon.ButtonIcon="{StaticResource fa-rotate}" Command="{Binding RefreshCleanupCommand}" />
                    <Button Content="{Binding CleanupButtonText}" Classes="accent" local:FaIcon.ButtonIcon="{StaticResource fa-broom}"
                            Command="{Binding CleanupCommand}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ══ About: not a step either, so it sits beside Cleanup, outlined and unnumbered ══ -->
      <TabItem Header="About" Classes="aside" DockPanel.Dock="Right" AutomationProperties.Name="About">
        <ScrollViewer Padding="0,12,8,8" local:ScrollShadow.IsEnabled="True" DataContext="{Binding About}" x:DataType="vm:AboutViewModel">
          <StackPanel>
            <Grid ColumnDefinitions="*,12,*">
              <!-- The app: its icon, version, the system it runs on and its data folder. -->
              <Border Classes="card">
                <Grid ColumnDefinitions="Auto,*">
                  <Image Source="/Assets/reelsmagician-128.png" Width="64" Height="64" Margin="0,0,16,0"
                         VerticalAlignment="Top" RenderOptions.BitmapInterpolationMode="HighQuality"
                         AutomationProperties.AccessibilityView="Raw" />
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Classes="h1" />
                    <SelectableTextBlock Text="{Binding VersionText}" FontWeight="SemiBold" />
                    <TextBlock Classes="hint" Margin="0,2,0,0"
                               Text="Free and open-source software under the BSD 3-Clause License." />

                    <TextBlock Text="System" Classes="label" Margin="0,12,0,2" />
                    <SelectableTextBlock Text="{Binding SystemText}" FontSize="12" TextWrapping="Wrap" />
                    <TextBlock Text="Data folder" Classes="label" Margin="0,10,0,2" />
                    <SelectableTextBlock Text="{Binding DataFolder}" FontSize="12" TextWrapping="Wrap" />

                    <Button Content="Copy path" local:FaIcon.ButtonIcon="{StaticResource fa-copy}"
                            Command="{Binding CopyDataFolderCommand}" HorizontalAlignment="Right" Margin="0,12,0,0" />
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Who makes it: the IDCT mark, drawn from assets/idct-mark.svg's path (Assets/IdctMark.axaml). -->
              <Border Grid.Column="2" Classes="card">
                <Grid ColumnDefinitions="Auto,*">
                  <Viewbox Width="64" Height="64" Margin="0,0,16,0" VerticalAlignment="Top"
                           AutomationProperties.AccessibilityView="Raw">
                    <Canvas Width="934" Height="934">
                      <Border Width="934" Height="934" CornerRadius="120" Background="{DynamicResource IdctMarkPlate}" />
                      <Path Data="{StaticResource IdctMark}" Fill="{DynamicResource IdctMarkAmber}" Stretch="None" />
                    </Canvas>
                  </Viewbox>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Made by IDCT" Classes="h1" />
                    <SelectableTextBlock Text="{Binding Company}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CompanyDescription}" Classes="hint" Margin="0,2,0,0" />
                    <Button Content="Visit idct.tech" local:FaIcon.ButtonIcon="{StaticResource fa-globe}"
                            Command="{Binding OpenCompanyCommand}" ToolTip.Tip="{Binding CompanyLink}"
                            HorizontalAlignment="Right" Margin="0,12,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Border Classes="card">
              <StackPanel>
                <TextBlock Text="Links" Classes="h2" />
                <local:InfoBox Text="Each opens in your browser. If none opens, the status bar shows the address." />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
                  <Button Content="Releases" local:FaIcon.ButtonIcon="{StaticResource fa-tag}"
                          Command="{Binding OpenReleasesCommand}" ToolTip.Tip="{Binding ReleasesLink}" />
                  <Button Content="Report a problem" local:FaIcon.ButtonIcon="{StaticResource fa-bug}"
                          Command="{Binding OpenIssuesCommand}" ToolTip.Tip="{Binding IssuesLink}" />
                  <Button Content="GitHub repository" local:FaIcon.ButtonIcon="{StaticResource fa-github}"
                          Command="{Binding OpenRepositoryCommand}" ToolTip.Tip="{Binding RepositoryLink}" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- The rows come from Licences in Core, which the logic checks hold to every build. -->
            <Border Classes="card">
              <StackPanel Grid.IsSharedSizeScope="True">
                <TextBlock Text="Licences" Classes="h2" />
                <local:InfoBox Margin="0,0,0,8"
                               Text="ReelsMagician and every component it uses come under their own licences. View licence shows the text this build carries. The ReelsMagician and IDCT names and logos are not covered by the BSD 3-Clause License." />

                <ContentControl Content="{Binding AppLicence}" ContentTemplate="{StaticResource LicenceRow}" />

                <ItemsControl ItemsSource="{Binding Groups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LicenceGroupViewModel">
                      <StackPanel Margin="0,14,0,0">
                        <TextBlock Text="{Binding Title}" Classes="h2" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Description}" Classes="hint" Margin="0,0,0,4" />
                        <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource LicenceRow}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Icons" Classes="label" Margin="0,16,0,2" />
                <SelectableTextBlock Text="{Binding FontAwesomeAttribution}" Foreground="{DynamicResource Muted}"
                                     FontSize="12" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                  <Button Content="View all third-party notices" local:FaIcon.ButtonIcon="{StaticResource fa-file-lines}"
                          Command="{Binding ViewNoticesCommand}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <!-- Status bar -->
    <Border Grid.Row="2" Classes="card" Margin="0,12,0,0" Padding="12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" />
          <ProgressBar Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding Progress}"
                       IsIndeterminate="{Binding Indeterminate}" IsVisible="{Binding IsBusy}" />
        </StackPanel>
        <Button Grid.Column="1" Content="Cancel" local:FaIcon.ButtonIcon="{StaticResource fa-xmark}" Command="{Binding CancelCommand}" Margin="12,0,0,0"
                VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>

    <!-- Support bar -->
    <Border Grid.Row="3" Classes="card" Margin="0,10,0,0" Padding="10,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="coffee" Command="{Binding OpenCoffeeCommand}"
                ToolTip.Tip="{x:Static vm:MainViewModel.CoffeeLink}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <local:FaIcon Data="{StaticResource fa-mug-hot}" Width="20" Height="20" />
            <TextBlock Text="Buy me a coffee" VerticalAlignment="Center" />
          </StackPanel>
        </Button>

        <TextBlock Grid.Column="1" Classes="hint" Margin="18,0" VerticalAlignment="Center"
                   TextAlignment="Center" TextWrapping="Wrap"
                   Text="ReelsMagician is free and open-source software, made in spare time and kept going by goodwill and coffee. If it saves you time, please support its development." />

        <Button Grid.Column="2" Classes="sponsor" Command="{Binding OpenSponsorsCommand}"
                ToolTip.Tip="{x:Static vm:MainViewModel.SponsorsLink}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <local:FaIcon Data="{StaticResource fa-heart}" Foreground="{DynamicResource SponsorHeart}" Width="18" Height="18" />
            <TextBlock Text="Sponsor on GitHub" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>
  </Grid>
</Window>
