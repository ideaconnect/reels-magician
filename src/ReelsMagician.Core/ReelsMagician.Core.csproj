<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ReelsMagician.Core</AssemblyName>
    <RootNamespace>ReelsMagician.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="OpenCvSharp5" Version="5.0.0.20261107" />
    <PackageReference Include="OpenCvSharp5.runtime.win" Version="5.0.0.20261107" />
    <!-- The headless build: OpenCV without its own windows, so it links nothing beyond the C and
         C++ runtimes. The full build links GTK 3, which a Linux system may not have (#37). -->
    <PackageReference Include="OpenCvSharp5.official.runtime.linux-x64.headless" Version="5.0.0.20261107" />
    <!-- .NET reads zip and gzip itself; ffmpeg's Linux builds come as .tar.xz. -->
    <PackageReference Include="SharpCompress" Version="0.50.8" />
  </ItemGroup>
  <ItemGroup>
    <!-- The messages Core shows the user, in English, with Strings.pl.resx beside it. The build
         generates the Strings class, so every key used in code is checked by the compiler. -->
    <EmbeddedResource Update="Localization\Strings.resx">
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>ReelsMagician.Core.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>
</Project>
